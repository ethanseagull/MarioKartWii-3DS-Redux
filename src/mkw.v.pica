.fvec projection[4], modelView[4], light, uvScroll
; Environment mapping for rigidly drawn menu models: rows of the bone's normal
; matrix, and (cos yaw, sin yaw, mix, 0). mix=0 keeps the vertex's own UV1.
.fvec envRow0, envRow1, envRow2, envParam
.fvec normalRow0, normalRow1, normalRow2
; Course-object material animation: affine rows u'=dot(row.xyz,(u,v,1)) for
; texcoord 0 (uvRow0/1) and 1 (uvRow2/3), and an RGBA multiplier on the
; vertex colour. Identity unless a draw animates its materials. The tint
; also carries the colour bytes' 1/255 scale (Renderer::kVertexColorScale).
.fvec uvRow0, uvRow1, uvRow2, uvRow3, tint
; Affine applied to UV1 last (rows dot (u,v,0,1)); identity outside GX
; EnvCamera materials whose texture SRT follows the environment projection.
.fvec uv1Row0, uv1Row1
; GX colour channel 0 (retail course lighting, src/renderer_retail.cpp):
;   colour = vertex * min(light + lightDiff * df(dot(n, lightDir.xyz)), lightDir.w)
; with the diffuse function df(x) = max(x*lightFn.x + lightFn.y, lightFn.z)
; (clamp, sign or none). Other draws pass light = ambient scale, lightDiff = 0.
.fvec lightDiff, lightDir, lightFn
; GX fog: texcoord2.x = eye depth normalized to the fog start/end
; (fogParam.z * view z + fogParam.w; x and y are zero), the coordinate of a
; fog ramp texture.
.fvec shadowDepth, shadowFloor, shadowReceiverFade
.fvec fogParam
; Light-texture materials: texcoord2 repeats the EnvCamera UV1 (lm_1).
.bool retailLightTexture
; Uniform branches skip work whose result cannot contribute to the draw.
.bool environmentMapped, environmentTexture2, environmentPrimary, diffuseLighting
.bool projectedWater, playerShadowProject, shadowCapture
; Unlit course objects keep their palette index in innormal.x. Lit racers
; use a separate attribute, retaining both UV pairs and bone-local normals.
.fvec bones[57]
.bool skinned, skinnedNormals, staticLighting
; The draw's UV rows and uv1Row are identity and uvScroll is zero (set per
; draw from the uniform values): the UVs pass through without the transforms.
.bool uvPlain
; uvPlain and none of playerShadowProject, environmentMapped,
; environmentTexture2, environmentPrimary, projectedWater, retailLightTexture
; or shadowCapture (Renderer::uvPlainNow): the short path below, without the
; branches for those features.
.bool fastPath
.constf constants(0.0, 1.0, 0.35, 0.65)
.constf half(0.5, 0.5, 0.5, 0.5)
.constf normalEpsilon(0.000000000001, 0.0, 0.0, 0.0)
.out outpos position
.out outtc texcoord0
.out outtcw texcoord0w.x
.out outtc1 texcoord1
.out outtc2 texcoord2
.out outcolor color
.alias inpos v0
.alias innormal v1
.alias inuv v2
.alias incolor v3
.alias inbone v4
.alias instaticuv v5
.proc main
    mov r15.xyz, innormal
    ; inpos has three components; set w to 1 explicitly. mov + dp4 is the
    ; console-tested form; dph with a uniform operand has not run on one.
    mov r0.xyz, inpos
    mov r0.w, constants.y
    ifu skinned
        ifu skinnedNormals
            mova a0.x, inbone.x
        .else
            mova a0.x, innormal.x
        .end
        dp4 r14.x, bones[a0.x], r0
        dp4 r14.y, bones[a0.x+1], r0
        dp4 r14.z, bones[a0.x+2], r0
        ifu shadowCapture
            ; Silhouette needs skinned positions and alpha only.
        .else
        ifu skinnedNormals
            ; Cofactor(B)*n / det(B) = inverse-transpose(B)*n. Its magnitude
            ; cancels in downstream normalization; keep determinant sign.
            ; This handles nonuniform bone scale without more bone uniforms.
            mov r0, bones[a0.x]
            mov r1, bones[a0.x+1]
            mov r2, bones[a0.x+2]
            mul r3.xyz, r1.yzx, r2.zxy
            mad r3.xyz, -r1.zxy, r2.yzx, r3
            dp3 r5.x, r3, innormal
            dp3 r6.x, r0, r3
            mul r3.xyz, r2.yzx, r0.zxy
            mad r3.xyz, -r2.zxy, r0.yzx, r3
            dp3 r5.y, r3, innormal
            mul r3.xyz, r0.yzx, r1.zxy
            mad r3.xyz, -r0.zxy, r1.yzx, r3
            dp3 r5.z, r3, innormal
            cmp constants.x, eq, eq, r6.x
            ifc cmp.x
                ; Original normalFromMat4 falls back to B when an authored
                ; squash makes the transform singular (e.g. Yoshi clips).
                dp3 r15.x, r0, innormal
                dp3 r15.y, r1, innormal
                dp3 r15.z, r2, innormal
            .else
                sge r6.x, r6.x, constants.x
                add r6.x, r6.x, r6.x
                add r6.x, -constants.y, r6.x
                mul r15.xyz, r5, r6.x
            .end
            ; Unnormalized: every user (EnvCamera, diffuse light, the Mii
            ; tail) normalizes after its linear transform, so the cofactor
            ; magnitude, which small authored scales change, drops out there.
        .end
        .end
        ; The cofactor rows above reuse r0.
        mov r0.xyz, r14.xyz
        mov r0.w, constants.y
    .end
    dp4 r12.x, modelView[0], r0
    dp4 r12.y, modelView[1], r0
    dp4 r12.z, modelView[2], r0
    dp4 r12.w, modelView[3], r0
    ; r12 is the view-space position (GX eye space: fog, projected rows).
    dp4 outpos.x, projection[0], r12
    dp4 outpos.y, projection[1], r12
    dp4 outpos.z, projection[2], r12
    dp4 outpos.w, projection[3], r12
    ifu fastPath
        ; What the general path below computes for these uniforms: both UV
        ; pairs as given, texcoord0w 1, the fog coordinate, the GX colour.
        ; Outputs are written as the general path writes them: one mov from a
        ; temporary each, outtc2 after the lighting. Writing them straight from
        ; an input or a mul froze the console on kart select (Azahar ran it).
        mov r13, inuv
        mov r5, inuv.zwxy
        mov r10, constants.yyyy
        mov outtc1, r5
        mov outtc, r13
        mov outtcw, r10.xxxx
        mov r13, half
        mul r13.x, fogParam.z, r12.z
        add r13.x, fogParam.w, r13.x
        ifu diffuseLighting
            mov r0.xyz, r15
            mov r0.w, constants.x
            dp3 r1.x, normalRow0, r0
            dp3 r1.y, normalRow1, r0
            dp3 r1.z, normalRow2, r0
            dp3 r2.x, r1, r1
            max r2.x, normalEpsilon.x, r2.x
            rsq r2.x, r2.x
            mul r1.xyz, r1, r2.x
            dp3 r2.x, lightDir, r1
            mul r2.x, lightFn.x, r2.x
            add r2.x, lightFn.y, r2.x
            max r2.x, lightFn.z, r2.x
            mul r3, lightDiff, r2.xxxx
            add r3, light, r3
        .else
            mov r3, light
        .end
        min r3, lightDir.wwww, r3
        mul r4, tint, r3
        mul r4, r4, incolor
        mov outtc2, r13
        mov outcolor, r4
    .else
    ifu playerShadowProject ; outputs-ok: this order since d28f093 (console)
        ; Exact receiver coordinates without material UV, fog or lighting work.
        ; Both body and local AO use actual geometry and the same depth test.
        mov r13, constants.xxxy
        dp4 r13.x, envRow0, r12
        dp4 r13.y, envRow1, r12
        dp4 r10.x, envRow2, r12
        mov outtc, r13
        mov outtcw, r10.xxxx
        mov r5, constants.xxxy
        dp4 r5.x, uv1Row0, r12
        dp4 r5.y, uv1Row1, r12
        mul r5.y, shadowReceiverFade.x, r5.y
        mul r11.x, shadowReceiverFade.y, incolor.w
        add r5.y, r11.x, r5.y
        add r5.y, shadowReceiverFade.z, r5.y
        mov outtc1, r5
        mov r14, constants.xxxy
        ifu environmentTexture2
            dp4 r14.x, normalRow0, r12
            dp4 r14.y, normalRow1, r12
        .else
            dp4 r14.x, shadowDepth, r12
            mov r14.y, half.y
        .end
        mov outtc2, r14
        ; Receiver TEV uses textures/constants only, not vertex colour.
        mov outcolor, constants.yyyy ; outputs-ok: uniform source since d28f093 (console)
    .else
    ifu uvPlain
        ; The same values as the transforms below with identity rows and no
        ; scroll (1*u+0*v+0 is exact in f24). Only xy of each texcoord
        ; reaches the rasterizer, so zw keep the other UV pair.
        mov r13, inuv
        mov r5, inuv.zwxy
        mov r14, r5
    .else
    mov r11, constants.yyyx
    mov r11.xy, inuv.xy
    mov r5, constants.xxxy
    dp3 r5.x, uvRow0, r11
    dp3 r5.y, uvRow1, r11
    add r5.xy, uvScroll.xy, r5.xy
    ; Keep primary UV in a temporary until EnvCamera has selected its result.
    ; Write each output attribute once per vertex, including on real PICA.
    mov r13, r5
    mov r11.xy, inuv.zw
    mov r5, constants.xxxy
    dp3 r5.x, uvRow2, r11
    dp3 r5.y, uvRow3, r11
    add r5.xy, uvScroll.zw, r5.xy
    ; A primary EnvCamera map must not overwrite the independent UV1 map.
    ; r14 is otherwise only used by the exclusive three-texture branch.
    mov r14, r5
    .end
    ifu environmentMapped
        ; Same equation as the CPU path: m=normalize(R*n),
        ; uv1=(0.5+0.5*(cos*m.x+sin*m.z), 0.5+0.5*m.y).
        mov r0.xyz, r15
        mov r0.w, constants.x
        dp3 r7.x, envRow0, r0
        dp3 r7.y, envRow1, r0
        dp3 r7.z, envRow2, r0
        dp3 r8.x, r7, r7
        max r8.x, normalEpsilon.x, r8.x
        rsq r8.x, r8.x
        mul r7.xyz, r7, r8.x
        mov r9, envParam
        mul r8.x, r9.x, r7.x
        mul r8.z, r9.y, r7.z
        add r8.x, r8.x, r8.z
        mov r8.y, r7.y
        mov r10, half
        mul r8.xy, r10.xy, r8.xy
        add r8.xy, r10.xy, r8.xy
        ifu environmentTexture2
            ; Three-map statues retain their independent marble UV1.
            ; The EnvCamera SRT instead feeds unit 2's third texture.
            mov r8.zw, constants.xy
            mov r14, constants.xxxy
            dp4 r14.x, uv1Row0, r8
            dp4 r14.y, uv1Row1, r8
        .else
            add r8.xy, r8.xy, -r5.xy
            mul r8.xy, r9.zz, r8.xy
            add r5.xy, r5.xy, r8.xy
        .end
    .end
    ifu environmentTexture2
        ifu staticLighting
            mov r14.xy, instaticuv.xy
        .end
        ; UV1 already has its authored SRT from the cooker/material animation.
    .else
        ifu uvPlain
        .else
        dp4 r11.x, uv1Row0, r5
        dp4 r11.y, uv1Row1, r5
        mov r5.xy, r11.xy
        .end
        ifu environmentPrimary
            ; Course-object EnvCamera may be the sole colour map (Chain Chomp).
            mov r13, r5
            mov r5, r14
        .end
    .end
    mov r10, constants.yyyy
    ifu projectedWater
        ; The affine wave remains on unit 1. Unit 0 receives homogeneous
        ; camera-projected coordinates; hardware divides by Q per fragment.
        mov r5, r13
        dp4 r13.x, envRow0, r12
        dp4 r13.y, envRow1, r12
        dp4 r10.x, envRow2, r12
        ; CPU sampled GX S17.7 offsets arrive as V-up texels. Each target
        ; texture normalizes independently; projected offsets multiply by Q
        ; so hardware's subsequent divide leaves a constant UV displacement.
        mul r11.xy, envParam.xy, inuv.zw
        add r5.xy, r5.xy, r11.xy
        mul r11.xy, envParam.zw, inuv.zw
        mul r11.xy, r11.xy, r10.xx
        add r13.xy, r13.xy, r11.xy
    .end
    mov outtc1, r5
    mov outtc, r13
    mov outtcw, r10.xxxx
    ; Fog coordinate: normalized GX eye depth (clamped by the ramp texture).
    mov r13, half
    mul r13.x, fogParam.z, r12.z
    add r13.x, fogParam.w, r13.x
    ifu diffuseLighting
        mov r0.xyz, r15
        mov r0.w, constants.x
        dp3 r1.x, normalRow0, r0
        dp3 r1.y, normalRow1, r0
        dp3 r1.z, normalRow2, r0
        dp3 r2.x, r1, r1
        max r2.x, normalEpsilon.x, r2.x
        rsq r2.x, r2.x
        mul r1.xyz, r1, r2.x
        ; GX colour channel: light + lightDiff * df(n.L), saturated at lightDir.w.
        dp3 r2.x, lightDir, r1
        mul r2.x, lightFn.x, r2.x
        add r2.x, lightFn.y, r2.x
        max r2.x, lightFn.z, r2.x
        mul r3, lightDiff, r2.xxxx
        add r3, light, r3
    .else
        mov r3, light
    .end
    min r3, lightDir.wwww, r3
    ; tint includes the 1/255 scale of the colour bytes.
    mul r4, tint, r3
    ; PICA requires all lanes of each output, including unused ones, written.
    mul r4, r4, incolor
    ifu environmentTexture2
        mov outtc2, r14
    .else
        ifu retailLightTexture
            ; lm_1 shares the EnvCamera coordinates of lm_0 (texture unit 1).
            mov outtc2, r5
        .else
            mov outtc2, r13
        .end
    .end
    ; Store light-depth in capture red; receiver red carries the same metric.
    ; RGB is discarded when shading the black silhouette, alpha stays intact.
    ifu shadowCapture
        dp4 r4.x, shadowDepth, r12
        ; Penetrating tire/body vertices cast from the supporting floor, not
        ; from behind it. Keep their silhouette UV and hardware capture depth.
        dp4 r14.x, shadowFloor, r12
        min r4.x, r4.x, r14.x
    .end
    mov outcolor, r4
    .end
    .end
    end
.end
